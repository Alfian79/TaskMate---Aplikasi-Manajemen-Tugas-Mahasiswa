# Salin file ini menjadi ".env" lalu isi dengan kredensial project Supabase milikmu.
# File ".env" TIDAK ikut di-push ke GitHub (sudah ada di .gitignore).
#
# Cara mengambil nilainya di dashboard Supabase:
#   URL -> Integrations > Data API > Project URL
#   KEY -> Settings > API Keys > "Publishable key" (diawali sb_publishable_)
#
# JANGAN pernah memakai "Secret key" (sb_secret_...) di aplikasi mobile:
# kunci itu menembus semua perlindungan Row Level Security.
# Setelah mengubah .env, jalankan ulang: npx expo start --clear
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
